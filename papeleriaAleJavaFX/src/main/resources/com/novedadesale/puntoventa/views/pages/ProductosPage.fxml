<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.*?>
<?import org.kordamp.ikonli.javafx.FontIcon?>

<VBox xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      styleClass="layout-page" VBox.vgrow="ALWAYS"
      fx:controller="com.novedadesale.puntoventa.controllers.ProductosController">

    <!-- ================= Vista de lista ================= -->
    <VBox fx:id="vistaLista" spacing="24" VBox.vgrow="ALWAYS">

        <!-- Header -->
        <HBox styleClass="page-header" spacing="12" alignment="CENTER_LEFT">
            <VBox spacing="6" HBox.hgrow="ALWAYS">
                <Label text="Productos" styleClass="label-title"/>
                <Label text="Gestiona tu catálogo: registra, edita y elimina productos" styleClass="label-subtitle"/>
            </VBox>
            <Button fx:id="btnNuevo" text="Nuevo producto" styleClass="btn-primary" graphicTextGap="8" onAction="#onNuevoProducto">
                <graphic><FontIcon iconLiteral="mdi2p-plus" iconSize="18"/></graphic>
            </Button>
        </HBox>

        <!-- Metrics -->
        <HBox styleClass="metrics-row" fillHeight="false">
            <VBox styleClass="metric-card gradient-1" HBox.hgrow="ALWAYS" spacing="6">
                <Label text="Total productos" styleClass="metric-title"/>
                <Label fx:id="lblTotalProductos" text="0" styleClass="metric-value"/>
                <Label text="en el catálogo" styleClass="metric-desc"/>
            </VBox>
            <VBox styleClass="metric-card gradient-2" HBox.hgrow="ALWAYS" spacing="6">
                <Label text="Stock bajo" styleClass="metric-title"/>
                <Label fx:id="lblStockBajo" text="0" styleClass="metric-value"/>
                <Label text="productos por reponer" styleClass="metric-desc"/>
            </VBox>
            <VBox styleClass="metric-card gradient-3" HBox.hgrow="ALWAYS" spacing="6">
                <Label text="Valor inventario" styleClass="metric-title"/>
                <Label fx:id="lblValorInventario" text="0" styleClass="metric-value"/>
                <Label text="a precio de venta" styleClass="metric-desc"/>
            </VBox>
            <VBox styleClass="metric-card gradient-4" HBox.hgrow="ALWAYS" spacing="6">
                <Label text="Categorías" styleClass="metric-title"/>
                <Label fx:id="lblCategorias" text="0" styleClass="metric-value"/>
                <Label text="secciones activas" styleClass="metric-desc"/>
            </VBox>
        </HBox>

        <!-- Catálogo -->
        <VBox styleClass="products-section" spacing="14" VBox.vgrow="ALWAYS">
            <HBox styleClass="section-header" spacing="10" alignment="CENTER_LEFT">
                <Label text="Catálogo" styleClass="label-heading"/>
                <Region HBox.hgrow="ALWAYS"/>
                <HBox styleClass="search-bar" alignment="CENTER_LEFT" spacing="8" prefWidth="300">
                    <FontIcon iconLiteral="mdi2m-magnify" iconSize="18"/>
                    <TextField fx:id="txtBuscar" promptText="Buscar por nombre o código..." styleClass="search-field"
                               HBox.hgrow="ALWAYS" maxWidth="Infinity"/>
                </HBox>
            </HBox>

            <HBox fx:id="chipsCategorias" styleClass="categories-bar" spacing="8" alignment="CENTER_LEFT"/>

            <TableView fx:id="tblProductos" styleClass="data-table" VBox.vgrow="ALWAYS">
                <columns>
                    <TableColumn fx:id="colCodigo" text="Código" prefWidth="110"/>
                    <TableColumn fx:id="colImagen" text="Imagen" prefWidth="80"/>
                    <TableColumn fx:id="colNombre" text="Producto" prefWidth="240"/>
                    <TableColumn fx:id="colCategoria" text="Categoría" prefWidth="150"/>
                    <TableColumn fx:id="colProveedor" text="Proveedor" prefWidth="170"/>
                    <TableColumn fx:id="colPrecio" text="Precio" prefWidth="110"/>
                    <TableColumn fx:id="colStock" text="Stock" prefWidth="90"/>
                    <TableColumn fx:id="colEstado" text="Estado" prefWidth="130"/>
                </columns>
            </TableView>
        </VBox>
    </VBox>

    <!-- ================= Vista de detalle ================= -->
    <VBox fx:id="vistaDetalle" spacing="20" VBox.vgrow="ALWAYS" visible="false" managed="false">

        <HBox styleClass="page-header" spacing="10" alignment="CENTER_LEFT">
            <Button text="Volver" styleClass="btn-secondary" graphicTextGap="8" onAction="#onVolverDetalle">
                <graphic><FontIcon iconLiteral="mdi2a-arrow-left" iconSize="18"/></graphic>
            </Button>
            <VBox spacing="4" HBox.hgrow="ALWAYS">
                <Label fx:id="lblDetalleNombre" text="Producto" styleClass="label-title"/>
                <Label fx:id="lblDetalleCodigo" text="" styleClass="label-subtitle"/>
            </VBox>
            <Label fx:id="lblEstadoDetalle" text="Disponible" styleClass="badge success"/>
            <Button fx:id="btnEditarDetalle" text="Editar" styleClass="btn-secondary" graphicTextGap="8" onAction="#onEditarDetalle">
                <graphic><FontIcon iconLiteral="mdi2p-pencil-outline" iconSize="18"/></graphic>
            </Button>
            <Button fx:id="btnEliminarDetalle" text="Eliminar" styleClass="btn-danger" graphicTextGap="8" onAction="#onEliminarDetalle">
                <graphic><FontIcon iconLiteral="mdi2t-trash-can-outline" iconSize="18"/></graphic>
            </Button>
            <Button fx:id="btnGuardarDetalle" text="Guardar" styleClass="btn-primary" graphicTextGap="8"
                    visible="false" managed="false" onAction="#onGuardarDetalle">
                <graphic><FontIcon iconLiteral="mdi2c-content-save-outline" iconSize="18"/></graphic>
            </Button>
            <Button fx:id="btnCancelarDetalle" text="Cancelar" styleClass="btn-secondary"
                    visible="false" managed="false" onAction="#onCancelarDetalle"/>
        </HBox>

        <HBox styleClass="products-section" spacing="28" alignment="TOP_LEFT">
            <VBox spacing="10" alignment="TOP_CENTER" minWidth="250">
                <StackPane styleClass="detail-image">
                    <ImageView fx:id="imgDetalle" fitWidth="220" fitHeight="220" preserveRatio="true"/>
                    <FontIcon fx:id="iconoImagenDetalle" iconLiteral="mdi2i-image-off-outline" iconSize="72"/>
                </StackPane>
                <Label fx:id="lblImagenDetalle" text="Sin imagen" styleClass="text-tertiary" wrapText="true"/>
                <HBox fx:id="accionesImagenDetalle" spacing="8" alignment="CENTER_LEFT"
                      visible="false" managed="false">
                    <Button text="Cambiar imagen" styleClass="btn-secondary" onAction="#onCambiarImagenDetalle"/>
                    <Button text="Quitar" styleClass="btn-secondary" onAction="#onQuitarImagenDetalle"/>
                </HBox>
            </VBox>

            <GridPane fx:id="gridDetalle" hgap="16" vgap="10" HBox.hgrow="ALWAYS">
                <columnConstraints>
                    <ColumnConstraints minWidth="110" prefWidth="120"/>
                    <ColumnConstraints hgrow="ALWAYS"/>
                </columnConstraints>

                <Label text="Código" styleClass="text-tertiary" GridPane.rowIndex="0" GridPane.columnIndex="0"/>
                <TextField fx:id="txtDetalleCodigo" maxWidth="Infinity" GridPane.rowIndex="0" GridPane.columnIndex="1"/>

                <Label text="Nombre" styleClass="text-tertiary" GridPane.rowIndex="1" GridPane.columnIndex="0"/>
                <TextField fx:id="txtDetalleNombre" maxWidth="Infinity" GridPane.rowIndex="1" GridPane.columnIndex="1"/>

                <Label text="Categoría" styleClass="text-tertiary" GridPane.rowIndex="2" GridPane.columnIndex="0"/>
                <ComboBox fx:id="cmbDetalleCategoria" maxWidth="Infinity" GridPane.rowIndex="2" GridPane.columnIndex="1"/>

                <Label text="Proveedor" styleClass="text-tertiary" GridPane.rowIndex="3" GridPane.columnIndex="0"/>
                <ComboBox fx:id="cmbDetalleProveedor" maxWidth="Infinity" GridPane.rowIndex="3" GridPane.columnIndex="1"/>

                <Label text="Contacto" styleClass="text-tertiary" GridPane.rowIndex="4" GridPane.columnIndex="0"/>
                <Label fx:id="lblDetalleContacto" text="Sin datos" styleClass="label-body" wrapText="true"
                       GridPane.rowIndex="4" GridPane.columnIndex="1"/>

                <Label text="Precio" styleClass="text-tertiary" GridPane.rowIndex="5" GridPane.columnIndex="0"/>
                <TextField fx:id="txtDetallePrecio" maxWidth="Infinity" GridPane.rowIndex="5" GridPane.columnIndex="1"/>

                <Label text="Stock" styleClass="text-tertiary" GridPane.rowIndex="6" GridPane.columnIndex="0"/>
                <TextField fx:id="txtDetalleStock" maxWidth="Infinity" GridPane.rowIndex="6" GridPane.columnIndex="1"/>

                <Label text="Stock mínimo" styleClass="text-tertiary" GridPane.rowIndex="7" GridPane.columnIndex="0"/>
                <TextField fx:id="txtDetalleStockMinimo" maxWidth="Infinity" GridPane.rowIndex="7" GridPane.columnIndex="1"/>
            </GridPane>
        </HBox>

        <VBox fx:id="cajaHistorial" styleClass="products-section" spacing="12" VBox.vgrow="ALWAYS">
            <HBox spacing="10" alignment="CENTER_LEFT">
                <Label text="Historial de cambios" styleClass="label-heading"/>
                <Region HBox.hgrow="ALWAYS"/>
                <Label text="Quién hizo cada cambio y cuándo" styleClass="text-tertiary"/>
            </HBox>
            <TableView fx:id="tblHistorial" styleClass="data-table" VBox.vgrow="ALWAYS">
                <columns>
                    <TableColumn fx:id="colHistFecha" text="Fecha y hora" prefWidth="160"/>
                    <TableColumn fx:id="colHistAccion" text="Acción" prefWidth="120"/>
                    <TableColumn fx:id="colHistUsuario" text="Usuario" prefWidth="150"/>
                    <TableColumn fx:id="colHistDetalle" text="Detalle" prefWidth="420"/>
                </columns>
            </TableView>
        </VBox>
    </VBox>
</VBox>
