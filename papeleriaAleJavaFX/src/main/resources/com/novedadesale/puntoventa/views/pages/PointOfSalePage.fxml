<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>
<?import org.kordamp.ikonli.javafx.FontIcon?>

<VBox xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      styleClass="layout-page pos-container" VBox.vgrow="ALWAYS" spacing="18"
      fx:controller="com.novedadesale.puntoventa.controllers.PointOfSaleController">

    <!-- Header -->
    <HBox styleClass="page-header" spacing="12" alignment="CENTER_LEFT">
        <VBox spacing="6" HBox.hgrow="ALWAYS">
            <Label text="Punto de venta" styleClass="label-title"/>
            <Label text="Selecciona productos y cobra la venta" styleClass="label-subtitle"/>
        </VBox>
    </HBox>

    <!-- Content -->
    <HBox spacing="18" VBox.vgrow="ALWAYS">
        <!-- Main -->
        <VBox styleClass="pos-main" spacing="18" HBox.hgrow="ALWAYS">
            <!-- Metrics -->
            <HBox styleClass="metrics-row" spacing="14" fillHeight="false">
                <VBox styleClass="metric-card gradient-1" HBox.hgrow="ALWAYS" spacing="6">
                    <Label text="Ventas del día" styleClass="metric-title"/>
                    <Label fx:id="lblVentasDia" text="0.00" styleClass="metric-value"/>
                    <Label text="corte de hoy" styleClass="metric-desc"/>
                </VBox>
                <VBox styleClass="metric-card gradient-2" HBox.hgrow="ALWAYS" spacing="6">
                    <Label text="Productos" styleClass="metric-title"/>
                    <Label fx:id="lblProductos" text="0" styleClass="metric-value"/>
                    <Label text="en inventario" styleClass="metric-desc"/>
                </VBox>
                <VBox styleClass="metric-card gradient-3" HBox.hgrow="ALWAYS" spacing="6">
                    <Label text="Valor inventario" styleClass="metric-title"/>
                    <Label fx:id="lblValorInventario" text="0.00" styleClass="metric-value"/>
                </VBox>
                <VBox styleClass="metric-card gradient-4" HBox.hgrow="ALWAYS" spacing="6">
                    <Label text="Stock bajo" styleClass="metric-title"/>
                    <Label fx:id="lblStockBajo" text="0" styleClass="metric-value"/>
                    <Label text="productos" styleClass="metric-desc"/>
                </VBox>
            </HBox>

            <!-- Products Section -->
            <VBox styleClass="products-section" spacing="14" VBox.vgrow="ALWAYS">
                <HBox styleClass="section-header" spacing="10" alignment="CENTER_LEFT">
                    <Label text="Productos" styleClass="label-heading"/>
                    <Region HBox.hgrow="ALWAYS"/>
                    <HBox styleClass="search-bar" alignment="CENTER_LEFT" spacing="8" prefWidth="300">
                        <FontIcon iconLiteral="mdi2m-magnify" iconSize="18"/>
                        <TextField fx:id="txtBuscarProducto" promptText="Buscar por nombre o código..."
                                   styleClass="search-field" HBox.hgrow="ALWAYS" maxWidth="Infinity"/>
                    </HBox>
                </HBox>
                <ScrollPane fitToWidth="true" VBox.vgrow="ALWAYS" styleClass="scroll-pane">
                    <FlowPane fx:id="productGrid" styleClass="product-grid" hgap="14" vgap="14"/>
                </ScrollPane>
            </VBox>
        </VBox>

        <!-- Cart -->
        <VBox styleClass="cart" minWidth="340" maxWidth="380" spacing="0">
            <VBox styleClass="cart-header" spacing="8">
                <Label text="Carrito de compras" styleClass="cart-title"/>
                <ComboBox fx:id="cmbCliente" maxWidth="Infinity" promptText="Cliente"/>
            </VBox>
            <ScrollPane fitToWidth="true" VBox.vgrow="ALWAYS" styleClass="scroll-pane">
                <VBox fx:id="cartItemsContainer" styleClass="cart-items"/>
            </ScrollPane>
            <VBox styleClass="cart-footer" spacing="10">
                <VBox styleClass="cart-total-section" spacing="8">
                    <HBox styleClass="totals-row">
                        <Label text="Subtotal" styleClass="total-label" HBox.hgrow="ALWAYS"/>
                        <Label fx:id="lblSubtotal" text="0.00" styleClass="total-value"/>
                    </HBox>
                    <HBox styleClass="totals-row">
                        <Label text="IVA (16%)" styleClass="total-label" HBox.hgrow="ALWAYS"/>
                        <Label fx:id="lblIVA" text="0.00" styleClass="total-value"/>
                    </HBox>
                    <HBox styleClass="totals-row">
                        <Label fx:id="lblDescuentoTexto" text="Descuento" styleClass="total-label" HBox.hgrow="ALWAYS"/>
                        <Label fx:id="lblDescuento" text="0.00" styleClass="total-value"/>
                    </HBox>
                    <Separator/>
                    <HBox styleClass="totals-row">
                        <Label text="Total a pagar" styleClass="total-grand" HBox.hgrow="ALWAYS"/>
                        <Label fx:id="lblTotal" text="0.00" styleClass="total-grand"/>
                    </HBox>
                </VBox>
                <Button text="Cobrar" styleClass="btn-primary" maxWidth="Infinity" prefHeight="46" onAction="#cobrar"/>
            </VBox>
        </VBox>
    </HBox>
</VBox>
