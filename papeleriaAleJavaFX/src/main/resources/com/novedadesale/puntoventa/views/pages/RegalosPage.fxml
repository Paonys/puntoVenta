<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import org.kordamp.ikonli.javafx.FontIcon?>

<VBox xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      styleClass="layout-page" VBox.vgrow="ALWAYS"
      fx:controller="com.novedadesale.puntoventa.controllers.RegalosController">

    <!-- Header -->
    <HBox styleClass="page-header" spacing="12" alignment="CENTER_LEFT">
        <VBox spacing="6" HBox.hgrow="ALWAYS">
            <Label text="Regalos" styleClass="label-title"/>
            <Label text="Catálogo de la sección de regalos" styleClass="label-subtitle"/>
        </VBox>
    </HBox>

    <!-- Metrics -->
    <HBox styleClass="metrics-row" spacing="14" fillHeight="false">
        <VBox styleClass="metric-card gradient-1" HBox.hgrow="ALWAYS" spacing="6">
            <Label text="Regalos" styleClass="metric-title"/>
            <Label fx:id="lblTotal" text="0" styleClass="metric-value"/>
            <Label text="productos" styleClass="metric-desc"/>
        </VBox>
        <VBox styleClass="metric-card gradient-2" HBox.hgrow="ALWAYS" spacing="6">
            <Label text="Valor inventario" styleClass="metric-title"/>
            <Label fx:id="lblValor" text="0.00" styleClass="metric-value"/>
            <Label text="a precio de venta" styleClass="metric-desc"/>
        </VBox>
        <VBox styleClass="metric-card gradient-3" HBox.hgrow="ALWAYS" spacing="6">
            <Label text="Stock bajo" styleClass="metric-title"/>
            <Label fx:id="lblStockBajo" text="0" styleClass="metric-value"/>
            <Label text="por reponer" styleClass="metric-desc"/>
        </VBox>
    </HBox>

    <!-- Catálogo -->
    <VBox styleClass="products-section" spacing="14" VBox.vgrow="ALWAYS">
        <HBox styleClass="section-header" spacing="10" alignment="CENTER_LEFT">
            <Label text="Sección de regalos" styleClass="label-heading"/>
            <Region HBox.hgrow="ALWAYS"/>
            <HBox styleClass="search-bar" alignment="CENTER_LEFT" spacing="8" prefWidth="300">
                <FontIcon iconLiteral="mdi2m-magnify" iconSize="18"/>
                <TextField fx:id="txtBuscar" promptText="Buscar regalo..."
                           styleClass="search-field" HBox.hgrow="ALWAYS" maxWidth="Infinity"/>
            </HBox>
        </HBox>
        <ScrollPane fitToWidth="true" VBox.vgrow="ALWAYS" styleClass="scroll-pane">
            <FlowPane fx:id="productGrid" styleClass="product-grid" hgap="14" vgap="14"/>
        </ScrollPane>
    </VBox>
</VBox>
