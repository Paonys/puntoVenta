<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import org.kordamp.ikonli.javafx.FontIcon?>

<VBox xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      styleClass="layout-page" VBox.vgrow="ALWAYS"
      fx:controller="com.novedadesale.puntoventa.controllers.DashboardController">

    <!-- Header -->
    <HBox styleClass="page-header" spacing="12" alignment="CENTER_LEFT">
        <VBox spacing="6" HBox.hgrow="ALWAYS">
            <Label text="Inicio" styleClass="label-title"/>
            <Label fx:id="lblFecha" text="Resumen del día" styleClass="label-subtitle"/>
        </VBox>
        <Button text="Actualizar" styleClass="btn-secondary" graphicTextGap="8" onAction="#recargar">
            <graphic><FontIcon iconLiteral="mdi2r-refresh" iconSize="18"/></graphic>
        </Button>
    </HBox>

    <!-- Metrics -->
    <HBox styleClass="metrics-row" spacing="14" fillHeight="false">
        <VBox styleClass="metric-card gradient-1" HBox.hgrow="ALWAYS" spacing="6">
            <Label text="Ventas del día" styleClass="metric-title"/>
            <Label fx:id="lblVentasDia" text="0.00" styleClass="metric-value"/>
            <Label text="ingresos de hoy" styleClass="metric-desc"/>
        </VBox>
        <VBox styleClass="metric-card gradient-2" HBox.hgrow="ALWAYS" spacing="6">
            <Label text="Ventas registradas" styleClass="metric-title"/>
            <Label fx:id="lblNumeroVentas" text="0" styleClass="metric-value"/>
            <Label text="tickets del día" styleClass="metric-desc"/>
        </VBox>
        <VBox styleClass="metric-card gradient-3" HBox.hgrow="ALWAYS" spacing="6">
            <Label text="Ticket promedio" styleClass="metric-title"/>
            <Label fx:id="lblTicketPromedio" text="0.00" styleClass="metric-value"/>
            <Label text="por venta" styleClass="metric-desc"/>
        </VBox>
        <VBox styleClass="metric-card gradient-4" HBox.hgrow="ALWAYS" spacing="6">
            <Label text="Stock bajo" styleClass="metric-title"/>
            <Label fx:id="lblStockBajo" text="0" styleClass="metric-value"/>
            <Label text="productos por reponer" styleClass="metric-desc"/>
        </VBox>
    </HBox>

    <!-- Paneles -->
    <HBox spacing="18" VBox.vgrow="ALWAYS">
        <VBox styleClass="products-section" spacing="14" HBox.hgrow="ALWAYS" minWidth="360">
            <HBox styleClass="section-header" spacing="10" alignment="CENTER_LEFT">
                <Label text="Productos más vendidos" styleClass="label-heading"/>
            </HBox>
            <TableView fx:id="tblMasVendidos" styleClass="data-table" VBox.vgrow="ALWAYS">
                <columns>
                    <TableColumn fx:id="colMvProducto" text="Producto" prefWidth="240"/>
                    <TableColumn fx:id="colMvCantidad" text="Vendidos" prefWidth="100"/>
                    <TableColumn fx:id="colMvImporte" text="Importe" prefWidth="120"/>
                </columns>
            </TableView>
        </VBox>

        <VBox styleClass="products-section" spacing="14" HBox.hgrow="ALWAYS" minWidth="420">
            <HBox styleClass="section-header" spacing="10" alignment="CENTER_LEFT">
                <Label text="Ventas de la jornada" styleClass="label-heading"/>
            </HBox>
            <TableView fx:id="tblVentas" styleClass="data-table" VBox.vgrow="ALWAYS">
                <columns>
                    <TableColumn fx:id="colFolio" text="Folio" prefWidth="100"/>
                    <TableColumn fx:id="colFecha" text="Hora" prefWidth="90"/>
                    <TableColumn fx:id="colCliente" text="Cliente" prefWidth="150"/>
                    <TableColumn fx:id="colMetodo" text="Pago" prefWidth="120"/>
                    <TableColumn fx:id="colTotal" text="Total" prefWidth="110"/>
                </columns>
            </TableView>
        </VBox>
    </HBox>

    <!-- Ingresos por método -->
    <HBox styleClass="metrics-row" spacing="14" fillHeight="false">
        <VBox styleClass="metric-card" HBox.hgrow="ALWAYS" spacing="6">
            <Label text="Efectivo" styleClass="label-subtitle"/>
            <Label fx:id="lblEfectivo" text="0.00" styleClass="label-heading"/>
        </VBox>
        <VBox styleClass="metric-card" HBox.hgrow="ALWAYS" spacing="6">
            <Label text="Tarjeta" styleClass="label-subtitle"/>
            <Label fx:id="lblTarjeta" text="0.00" styleClass="label-heading"/>
        </VBox>
        <VBox styleClass="metric-card" HBox.hgrow="ALWAYS" spacing="6">
            <Label text="Transferencia" styleClass="label-subtitle"/>
            <Label fx:id="lblTransferencia" text="0.00" styleClass="label-heading"/>
        </VBox>
    </HBox>
</VBox>
