<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      styleClass="cart" minWidth="340" maxWidth="380" spacing="0">
    <VBox styleClass="cart-header" spacing="6">
        <Label text="Carrito de compras" styleClass="cart-title"/>
    </VBox>
    <ScrollPane fitToWidth="true" VBox.vgrow="ALWAYS" styleClass="scroll-pane">
        <VBox fx:id="itemsContainer" styleClass="cart-items"/>
    </ScrollPane>
    <VBox styleClass="cart-footer" spacing="10">
        <VBox styleClass="cart-total-section" spacing="8">
            <HBox styleClass="totals-row">
                <Label text="Subtotal" styleClass="total-label" HBox.hgrow="ALWAYS"/>
                <Label fx:id="lblSubtotal" text=".00" styleClass="total-value"/>
            </HBox>
            <HBox styleClass="totals-row">
                <Label text="IVA (16%)" styleClass="total-label" HBox.hgrow="ALWAYS"/>
                <Label fx:id="lblIVA" text=".00" styleClass="total-value"/>
            </HBox>
            <HBox styleClass="totals-row">
                <Label text="Descuento" styleClass="total-label" HBox.hgrow="ALWAYS"/>
                <Label fx:id="lblDescuento" text=".00" styleClass="total-value"/>
            </HBox>
            <Separator/>
            <HBox styleClass="totals-row">
                <Label text="Total a pagar" styleClass="total-grand" HBox.hgrow="ALWAYS"/>
                <Label fx:id="lblTotal" text=".00" styleClass="total-grand"/>
            </HBox>
        </VBox>
        <Button text="Cobrar" styleClass="btn-primary" maxWidth="Infinity" prefHeight="46"/>
    </VBox>
</VBox>
