<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.VBox?>
<?import javafx.geometry.Insets?>

<VBox xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.novedadesale.puntoventa.controllers.molecules.ProductCardController"
      styleClass="product-card card-hover" spacing="8" prefWidth="180" minWidth="160">
    <VBox fx:id="imgContainer" styleClass="product-image" alignment="CENTER" VBox.vgrow="NEVER"/>
    <VBox spacing="4" VBox.vgrow="ALWAYS">
        <Label fx:id="lblPrice" styleClass="product-price" text=".00"/>
        <Label fx:id="lblName" styleClass="product-name" wrapText="true" text="Producto"/>
        <Label fx:id="lblStock" styleClass="product-stock" text="Stock: 0"/>
    </VBox>
    <Button fx:id="btnAdd" text="Agregar" styleClass="btn-primary button-hover" maxWidth="Infinity" onAction="#onAddToCart"/>
</VBox>
