<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>

<HBox xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      styleClass="topbar" alignment="CENTER_LEFT" spacing="20">
    <HBox styleClass="logo-container" alignment="CENTER_LEFT" spacing="10">
        <ImageView fitWidth="180" fitHeight="60" preserveRatio="true">
            <image>
                <Image url="@/com/novedadesale/puntoventa/images/logo.png"/>
            </image>
        </ImageView>
    </HBox>
    <Pane HBox.hgrow="ALWAYS" styleClass="topbar-spacer"/>
    <fx:include source="../molecules/SearchBar.fxml"/>
    <HBox styleClass="user-menu" alignment="CENTER" spacing="8">
        <Label text="CA" styleClass="user-avatar"/>
        <Label text="Caja 1" styleClass="user-name"/>
    </HBox>
</HBox>
