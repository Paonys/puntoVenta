<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import org.kordamp.ikonli.javafx.FontIcon?>

<VBox xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      styleClass="layout-page" spacing="20">
    <VBox styleClass="page-header" spacing="6">
        <Label text="Reportes" styleClass="label-title"/>
        <Label text="Ventas y estadísticas" styleClass="label-subtitle"/>
    </VBox>
    <VBox styleClass="products-section empty-state" VBox.vgrow="ALWAYS">
        <StackPane styleClass="empty-icon-circle">
            <FontIcon iconLiteral="mdi2c-chart-box-outline" iconSize="34"/>
        </StackPane>
        <Label text="Reportes en construcción" styleClass="empty-state-title"/>
        <Label text="Aquí verás el desempeño de la tienda: ventas por período, productos más vendidos y utilidades." styleClass="empty-state-text" wrapText="true"/>
    </VBox>
</VBox>